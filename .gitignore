.recon/

# DEG corpus data files (large, not for Git)
app/deg-server/data/deg-inquiries-full.json
apps/deg-server/data/deg-inquiries-full.json
ingestion/deg-backfill/deg.sqlite

# Generated D1 import — ~35 MB, derived from the corpus JSON above by
# scripts/build-d1-sql.ts. The schema and FTS migrations beside it ARE tracked.
apps/deg-server/migrations/0002_data.sql

# Local wrangler state: miniflare D1, caches, and the bundles `wrangler dev`
# writes to tmp. Every Worker in the repo grows one of these the first time it
# is run locally, so this is matched by name rather than by path. It used to
# name apps/deg-server explicitly, which meant apps/site quietly staged 10 files
# of build scratch the first time it was committed.
**/.wrangler/

# SQLite WAL sidecars (transient, recreated on every open)
*.sqlite-shm
*.sqlite-wal
# Worktrees
.worktrees/
# Docs scratch
docs/superpowers/

# gstack local reports (security audits etc.) — stay local
.gstack/
