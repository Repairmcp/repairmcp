{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repairmcp-site",
  "compatibility_date": "2026-08-01",

  // Assets-only. There is deliberately no "main" here: nothing runs, no
  // isolate is spun up, no request is billed as a Worker invocation. Every
  // response header comes from public/_headers.
  //
  // The moment a "main" is added with run_worker_first, _headers stops
  // applying and header management moves into code. Don't do that without
  // moving the whole header set at the same time.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  // LAUNCHED 2026-08-27. The apex is the site. The old Namecheap parking
  // records on @ and www were deleted in the dashboard first (the runbook in
  // README.md); the domain's MX / SPF email-forwarding records were left
  // alone. www is a dashboard-side proxied CNAME plus a 301 redirect rule to
  // the apex, not a route here. preview.repairmcp.com was retired at launch
  // per the runbook.
  "routes": [{ "pattern": "repairmcp.com", "custom_domain": true }],

  // Same reasoning as apps/deg-server: one public hostname, not two. A
  // workers.dev URL would be a second door that the zone's rules do not
  // cover, and the account has no workers.dev subdomain registered anyway.
  "workers_dev": false,

  "observability": {
    "enabled": true
  }
}
