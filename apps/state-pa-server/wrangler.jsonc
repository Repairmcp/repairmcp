{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repairmcp-state-pa",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",

  // Same insurance as the other servers: the web-standard transport should
  // need nothing from node, but the MCP SDK is a large tree and a missing
  // builtin surfaces as a cryptic bundling failure.
  "compatibility_flags": ["nodejs_compat"],

  // No D1, no upstream cache. The whole corpus ships inside the bundle
  // (validated once per isolate), so a corpus refresh IS a deploy — re-run
  // scripts/capture-state.ts --state pa, then wrangler deploy. The capture
  // pipelines are not in the package barrel and never reach this bundle.

  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": {
    "enabled": true
  },

  // Tool-usage telemetry — the shared cross-server dataset. Blob layout and
  // the no-arguments rule: packages/core/src/server/usage.ts.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "repairmcp_usage" }],

  // The only public entrance. The zone's single WAF rate-limit rule matches
  // path /mcp; it fired on this hostname at launch (20 pass, then 429s,
  // 2026-09-14) while fl., ca., deg., and ny. returned 0/30 — burst-test
  // after deploy anyway.
  "routes": [{ "pattern": "pa.repairmcp.com", "custom_domain": true }],

  // Deliberate, and it stays false — one hostname, the one the WAF rule
  // protects. A workers.dev URL would be a second, unrated door.
  "workers_dev": false
}
