{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repairmcp-deg",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",

  // Insurance only. The web-standard transport is written against Request /
  // Response / ReadableStream and should need nothing from node, but the MCP
  // SDK is a large dependency tree and a missing builtin surfaces as a cryptic
  // bundling failure. Drop this once a clean build confirms it is unused.
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repairmcp-deg",
      // From `wrangler d1 create repairmcp-deg`, region WNAM, 2026-08-03.
      "database_id": "c0a4f4f0-aec8-4d1e-b947-647353033448"
    }
  ],

  "vars": {
    // Part of the result-cache key, and the whole cache invalidation mechanism —
    // see src/cache.ts.
    //
    // Set it to the corpus's own `syncedAt`, the value `corpus_meta` carries and
    // /health reports. Tying the two together means the bump is no longer
    // something to remember: a refresh moves the sync date, the sync date is the
    // key, and /health answers `corpusVersionStale: true` the moment they drift.
    "CORPUS_VERSION": "2026-08-27"
  },

  // Hands the Worker its own deployment id at runtime, so /health can answer
  // "did my deploy land?". Without it the version field is a source constant
  // that reads identically before and after a deploy — which is exactly the
  // question you curl /health to settle.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": {
    "enabled": true
  },

  // Tool-usage telemetry. All six MCP workers write to this ONE shared dataset
  // (each row carries its vertical as blob1/index1), so a single Analytics
  // Engine query answers "which tools, which clients, which states" across the
  // whole product. Rows carry tool and client names only — never query
  // arguments, which can hold VINs and claim details. See
  // packages/core/src/server/usage.ts for the blob layout.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "repairmcp_usage" }],

  // The only public entrance. Cloudflare creates the DNS record and issues the
  // certificate on deploy; nothing needs adding by hand in the dashboard.
  //
  // This deploy fails until the repairmcp.com zone is active on the account —
  // that is the intended behaviour, not something to work around. A custom
  // domain is also what makes the WAF rate limit rule possible at all; rate
  // limiting rules are zone-scoped and cannot cover a workers.dev hostname.
  "routes": [{ "pattern": "deg.repairmcp.com", "custom_domain": true }],

  // Deliberate, and it stays false after the custom domain lands. The corpus is
  // public and unauthenticated, so it should have exactly one hostname — the one
  // the rate limit rule protects. A workers.dev URL would be a second, unrated
  // door into the same data. The account has no workers.dev subdomain registered
  // today, so this also stops a future deploy from publishing by surprise if one
  // is ever registered for another project.
  "workers_dev": false
}
