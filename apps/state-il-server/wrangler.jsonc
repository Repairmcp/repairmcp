{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repairmcp-state-il",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",

  // Same insurance as the other servers: the web-standard transport should
  // need nothing from node, but the MCP SDK is a large tree and a missing
  // builtin surfaces as a cryptic bundling failure.
  "compatibility_flags": ["nodejs_compat"],

  // No D1, no upstream cache. The whole corpus ships inside the bundle
  // (validated once per isolate), so a corpus refresh IS a deploy — re-run
  // scripts/capture-state.ts --state il, then wrangler deploy. The capture
  // pipeline is not in the package barrel and never reaches this bundle.

  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": {
    "enabled": true
  },

  // Tool-usage telemetry — the shared cross-server dataset. Blob layout and
  // the no-arguments rule: packages/core/src/server/usage.ts.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "repairmcp_usage" }],

  // The only public entrance. Burst-test the zone WAF rule after deploy —
  // it fired on pa. and oh. but not on fl., ca., deg., or ny. (CLAUDE.md Backlog).
  "routes": [{ "pattern": "il.repairmcp.com", "custom_domain": true }],

  // Deliberate, and it stays false — one hostname, the one the WAF rule
  // protects. A workers.dev URL would be a second, unrated door.
  "workers_dev": false
}
